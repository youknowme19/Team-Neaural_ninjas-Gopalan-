# LiveSpeak Environment Template (Example)
# Copy this file to .env and provide your configuration. Never commit actual secret keys!

# Route B: Groq High-Speed API Provider (Optional)
# Obtain an API key from https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# Groq Model Selection (Default: llama-3.1-8b-instant)
GROQ_MODEL=llama-3.1-8b-instant

# Route A: Local llama.cpp Provider (Optional custom path overrides)
# If not set, LiveSpeak searches src-tauri/models/ and src-tauri/bin/
# QWEN_MODEL_PATH=/path/to/qwen2.5-0.5b-instruct.gguf
# LLAMA_CPP_PATH=/path/to/llama-cli

# Local LLM (Clean Up Route A, live translation, Catch me up) - all on 127.0.0.1
# LLAMA_SERVER_PATH=/path/to/llama-server
# LIVESPEAK_LLAMA_PORT=8089          # Qwen: Clean Up + Catch me up summaries
# LIVESPEAK_TRANSLATION_PORT=8090    # Gemma: live caption translation
# LIVESPEAK_TRANSLATION_MODEL=/path/to/gemma-3-1b-it-Q4_K_M.gguf
